<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercicio - Médias Escolares</title>
    <style>
        /* Configurações Globais */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Fundo Laranja Vibrante e Profundo */
        body {
            background: linear-gradient(135deg, #1d0c39, #310874, #2d55f6);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
        }

        /* Espaçador superior para manter o card centralizado */
        .espacador {
            flex: 1;
        }

        /* Cartão Principal */
        #conteudo {
            width: 380px;
            background-color: #ffffff;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
            overflow: hidden;
            margin: 20px 0;
        }

        /* Cabeçalho Laranja */
        #titulo {
            background-color: #024579;
            color: #ffffff;
            padding: 20px;
            text-align: center;
            font-size: 1.5em;
            font-weight: bold;
            letter-spacing: 1px;
        }

        /* Área do Form */
        #form {
            padding: 25px;
        }

        /* Estilização e Espaçamento dos Campos */
        #form form {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        #form label {
            font-size: 0.9em;
            color: #333333;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        #form input[type="text"] {
            width: 60%;
            padding: 8px 12px;
            border: 1px solid #cccccc;
            border-radius: 6px;
            outline: none;
            font-size: 1em;
            text-align: center;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        #form input[type="text"]:focus {
            border-color: #100346;
            box-shadow: 0 0 5px rgba(20, 1, 115, 0.3);
        }

        /* Botão calcular */
        #botao_calcular {
            margin-top: 6px;
            padding: 12px;
            background-color: #1b74e1;
            border: none;
            border-radius: 6px;
            color: #ffffff;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;

        }

        
        #botao:hover {
            background-color: #1b74e1;
           
        }

        #botao:active {
            transform: scale(0.98);
        }


             /* Botão 'limpar' */
        #botao_limpar {
            margin-top: 6px;
            padding: 12px;
            background-color: #59dca3;
            border: none;
            border-radius: 6px;
            color: #ffffff;
            font-size: 1em;
            font-weight: bold;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.1s;
        }

        #botao:hover {
            background-color: #59dca3;
            
        }

        #botao:active {
            transform: scale(0.98);
        }

        /* Área de Resultados */
        #painel-resultados {
            background-color: #fff8f5;
            border-top: 1px solid #ffe0b2;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            text-align: center;
        }

        .bloco-resultado {
            width: 48%;
        }

        .rotulo {
            font-size: 0.8em;
            color: #301d7c;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 5px;
        }

        #resultado, #status {
            font-size: 1.5em;
            font-weight: bold;
    
        }

        .Aprovado {
            color: rgb(26, 177, 26);
        }
        .Exame {
            color: orange;
        }
        .Reprovado {
            color: red;
        }




        /* Rodapé do Site (fora da div #conteudo) */
        #rodape-site {
            width: 100%;
            padding: 15px;
            text-align: center;
            font-size: 0.85em;
            color: rgba(255, 255, 255, 0.8);
            font-weight: 500;
            background-color: rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(5px);
        }
    </style>
    <script>
        //função para calcular a média
        function calcular_media (){
        

            //Serve para colocar um alerta no navegador
           // alert('Bem vindo ao sistema de calculo') 

            //Serve para fazer uma pergunta para o usuário
            //confirm('Deseja realmente calcular?')

            //Serve para solicitar uma entrada de dados
            //var nome = prompt('Digite o seu nome: ')

            //serve para colocar uma mesagem na área de debug do navegador
            //console.log('Testando o Debug em JS ' + nome)

            
                var valor1 = document.getElementById('valor1')
                var valor2 = document.getElementById('valor2')
                var valor3 = document.getElementById('valor3')
                var valor4 = document.getElementById('valor4')


                //Recebe o elemento HTML para colocar o resultado da média encontrada e o Status
                var resultado = document.getElementById('resultado')
                var status = document.getElementById('status')

             //if(valor1.value == '' || valor2.value == '' || valor3.value == '' || valor4.value == ''){
            //Essa versão acima é para mensagem generica,agora, para fazer uma personalizada basta seguir a forma abaixo:
            //Quand0 tiver mais de uma condição que devemos utilizar o 'IF', usar na seguintes 'ELSE IF'.

          

            //Limpandoas as 4 caixas de valores. Isso serve para limpar tudo antes de testar as condições.
            // Pois caso a pessoa reescreva a nota em alguma caixa depois de clicar novamente no botão
            // A caixa será limpa logo após o preenchiemento, e caso algo ainda estiver sem preencher,a caixa fica vermelha
            //o 'ffffff' é a cor BRANCA

            valor1.style.backgroundColor = '#ffffff'
            valor2.style.backgroundColor = '#ffffff'
            valor3.style.backgroundColor = '#ffffff'
            valor4.style.backgroundColor = '#ffffff'



              if(valor1.value == ''){
                // style.backgroundColor -> permite trocar o cor do fundo
                   valor1.style.backgroundColor = '#b8706e' 
                  alert('A caixa referente ao valor 1 não foi preenchida. Digite um valor de 0 a 10')

            }else if(valor2.value == ''){
                valor2.style.backgroundColor = '#b8706e'
                alert('A caixa referente ao valor 2 não foi preenchida. Digite um valor de 0 a 10')
              
            }else if(valor3.value == ''){
                valor3.style.backgroundColor = '#b8706e'
                alert('A caixa referente ao valor 3 não foi preenchida. Digite um valor de 0 a 10')

            }else if(valor4.value == ''){
                valor4.style.backgroundColor = '#b8706e'
                alert('A caixa referente ao valor 4 não foi preenchida. Digite um valor de 0 a 10')
              
            }else{
                // Realiza o calculo da média 
                // number()-> Converte uma String para número
        var media= (Number (valor1.value)+ Number(valor2.value)+ Number( valor3.value )+ Number ( valor4.value)) /4


  // colocando o valor da média no elemento HTML 
  //toFixed - Permite limitar a qtd de casas decimais 
            resultado.innerText= media.toFixed(1)

    //Essa estrutura é a validação de status de aprovação do aluno
            if(media >= 7){
                status.innerText = 'Aprovado'
                status.className = 'Aprovado'
                resultado.className = 'Aprovado'
            }else if(media >= 5 && media <7){
                status.innerText = 'Exame'
                status.className = 'Exame'
                resultado.className = 'Exame'
            }else if(media <5){
                status.innerText = 'Reprovado'
                status.className = 'Reprovado'
                resultado.className = 'Reprovado'
            }


            }
        }
 //função que após o usuário clicar no botão "Limpar" tudo que foi escrito sera limpo automáticamnete
        function limpar_caixas_de_texto(){


        //Limpa as caixas de texto, aonde ficam os numeros para cálculo 
        document.getElementById('valor1').value = ''
        document.getElementById('valor2').value = ''
        document.getElementById('valor3').value = ''
        document.getElementById('valor4').value = ''


        //Limpa as caixas de resultado e de status
        document.getElementById('resultado').innerText = '0.0'
        document.getElementById('status').innerText = '-'


        // pinta as caixas de texto de branco 
        document.getElementById('valor1').style.backgroundColor = '#ffffff'
        document.getElementById('valor2').style.backgroundColor = '#ffffff'
        document.getElementById('valor3').style.backgroundColor = '#ffffff'
        document.getElementById('valor4').style.backgroundColor = '#ffffff'



        }
    </script>
</head>
<body>

    <div class="espacador"></div>

    <div id="conteudo">
        <div id="titulo">
            Médias Escolares
        </div>

        <div id="form">
            <form name="frmmedia">
                <label>Nota 1: <input type="text" name="txtn1" id="valor1"></label>
                <label>Nota 2: <input type="text" name="txtn2" id="valor2"></label>
                <label>Nota 3: <input type="text" name="txtn3" id="valor3"></label>
                <label>Nota 4: <input type="text" name="txtn4" id="valor4"></label>
                <input type="button" name="btncalc" id="botao_calcular" value="Calcular Média" onclick="calcular_media()">
                <input type="button" name="btlimp" id="botao_limpar"  value="Limpar" onclick="limpar_caixas_de_texto()">



            </form>
        </div>

        <div id="painel-resultados">
            <div class="bloco-resultado">
                <div class="rotulo">Média</div> 
                <div id="resultado">0.0</div>
            </div>
            <div class="bloco-resultado">
                <div class="rotulo">Status</div>
                <div id="status">-</div>
            </div>
        </div>
    </div>

    <div class="espacador"></div>

    <!-- Rodapé fora da caixa de conteúdo -->
    <footer id="rodape-site">
        Isabela - Desenvolvimento Javascript - Projeto Acadêmico
    </footer>

</body>
</html>
